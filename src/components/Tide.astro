---
/**
 * The tide, in the same soft, painterly style as the rest of the site:
 * clear aqua water rises up a pale shore and slowly draws back (flood and ebb),
 * leaving a darker band of wet sand. A white line of foam rides the water's edge,
 * small waves run up the beach, and bands of light drift through the water.
 * Decorative only. With "Pause motion" or reduced motion it rests as a still image.
 */
const uid = `td${Math.random().toString(36).slice(2, 8)}`;

// The scene is drawn in a tilted frame: the shoreline runs across at y ≈ EDGE,
// sand above it, sea below it. The whole frame is rotated so the shore runs on a diagonal.
const EDGE = 390;
const X0 = -260;
const X1 = 880;

const edgeY = (x: number, shift = 0) => EDGE + shift + 11 * Math.sin(x / 95 + 0.6) + 6 * Math.sin(x / 41 + 1.9);
const edgePts = (shift = 0, step = 20) => {
  const pts: string[] = [];
  for (let x = X0; x <= X1; x += step) pts.push(`${x} ${edgeY(x, shift).toFixed(1)}`);
  return pts;
};

// the sea: everything below the (wavy) water's edge
const sea = `M${edgePts().join(' L')} L${X1} 1000 L${X0} 1000 Z`;
// the line of foam along the edge, and a fainter second line a little way out
const foam = `M${edgePts(0, 10).join(' L')}`;
const foamOut = `M${edgePts(26, 10).join(' L')}`;
// wet sand: a band just above the high-water line, visible as the water draws back
const wet = `M${edgePts(-70).join(' L')} L${edgePts(10).reverse().join(' L')} Z`;

// soft bands of light drifting along the shore inside the water (one period wider so the drift loops)
const P = 320;
const band = (base: number, thick: number, amp: number, ph: number) => {
  const top: string[] = [];
  const bot: string[] = [];
  for (let x = X0; x <= X1 + P; x += 30) {
    const t = (x / P) * Math.PI * 2;
    top.push(`${x} ${(base + amp * Math.sin(t + ph)).toFixed(1)}`);
    bot.push(`${x} ${(base + thick + amp * 0.8 * Math.sin(t + ph + 0.9)).toFixed(1)}`);
  }
  return `M${top.join(' L')} L${bot.reverse().join(' L')} Z`;
};
const bands = [
  { d: band(EDGE + 40, 50, 10, 0.4), cls: 'td-band--white', dur: 28 },
  { d: band(EDGE + 130, 90, 14, 2.1), cls: 'td-band--deep', dur: 36 },
  { d: band(EDGE + 250, 60, 12, 4.0), cls: 'td-band--white', dur: 24 },
];

// small waves running up the beach: a short curved crest that slides shoreward and fades
const swash = [
  { x: 40, w: 150, dur: 6.5, delay: 0 },
  { x: 260, w: 190, dur: 7.2, delay: 2.2 },
  { x: 480, w: 160, dur: 6.8, delay: 4.1 },
  { x: 150, w: 120, dur: 7.6, delay: 5.0 },
];
const glints = [
  [60, EDGE + 90, 46],
  [300, EDGE + 120, 60],
  [180, EDGE + 190, 38],
  [470, EDGE + 160, 44],
  [380, EDGE + 240, 52],
];
---

<div class="tide" aria-hidden="true">
  <svg viewBox="0 0 600 720" preserveAspectRatio="xMidYMid meet" focusable="false">
    <defs>
      <linearGradient id={`${uid}-sea`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color: var(--hero-sea); stop-opacity: 0.45"></stop>
        <stop offset="0.35" style="stop-color: var(--hero-sea); stop-opacity: 0.7"></stop>
        <stop offset="1" style="stop-color: var(--hero-deep); stop-opacity: 0.7"></stop>
      </linearGradient>
      <linearGradient id={`${uid}-sand`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" class="td-sand-stop" stop-opacity="0"></stop>
        <stop offset="0.7" class="td-sand-stop" stop-opacity="1"></stop>
        <stop offset="1" class="td-sand-stop" stop-opacity="1"></stop>
      </linearGradient>
      <!-- the scene dissolves into the page at its edges -->
      <radialGradient id={`${uid}-fade`} cx="0.5" cy="0.5" r="0.5">
        <stop offset="0.6" stop-color="#fff" stop-opacity="1"></stop>
        <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
      </radialGradient>
      <mask id={`${uid}-mask`}>
        <ellipse cx="320" cy="400" rx="380" ry="330" fill={`url(#${uid}-fade)`}></ellipse>
      </mask>
      <clipPath id={`${uid}-clip`}>
        <path d={sea}></path>
      </clipPath>
      <filter id={`${uid}-soft`} x="-20%" y="-40%" width="140%" height="180%">
        <feGaussianBlur stdDeviation="12"></feGaussianBlur>
      </filter>
      <filter id={`${uid}-edge`} x="-10%" y="-20%" width="120%" height="140%">
        <feGaussianBlur stdDeviation="5"></feGaussianBlur>
      </filter>
      <filter id={`${uid}-foam`} x="-10%" y="-100%" width="120%" height="300%">
        <feGaussianBlur stdDeviation="1.4"></feGaussianBlur>
      </filter>
    </defs>

    <g mask={`url(#${uid}-mask)`}>
      <g transform="rotate(-16 320 400)">
        <!-- the shore: pale sand, with a darker band of wet sand the tide leaves behind -->
        <rect x={X0} y={EDGE - 300} width={X1 - X0} height="380" fill={`url(#${uid}-sand)`} filter={`url(#${uid}-soft)`}></rect>
        <path class="td-wet" d={wet} filter={`url(#${uid}-edge)`}></path>

        <!-- the sea rises up the shore and draws back: flood, then ebb -->
        <g class="td-tide">
          <path d={sea} fill={`url(#${uid}-sea)`} filter={`url(#${uid}-edge)`}></path>
          <g clip-path={`url(#${uid}-clip)`}>
            <g filter={`url(#${uid}-soft)`}>
              {bands.map((b) => <path class={`td-band ${b.cls}`} d={b.d} style={`--dur:${b.dur}s`} />)}
            </g>
            <g class="td-glints">
              {glints.map(([x, y, w]) => <path class="td-glint" d={`M${x} ${y} q ${w / 2} -${(w / 7).toFixed(1)} ${w} 0`} />)}
            </g>
          </g>
          <!-- foam at the water's edge, and a fainter line just behind it -->
          <g filter={`url(#${uid}-foam)`}>
            <path class="td-foam" d={foam} />
            <path class="td-foam td-foam--out" d={foamOut} />
          </g>
          <!-- small waves running up the beach -->
          <g filter={`url(#${uid}-foam)`}>
            {
              swash.map((s) => (
                <path
                  class="td-swash"
                  d={`M${s.x} ${(edgeY(s.x) + 46).toFixed(1)} q ${s.w / 2} -18 ${s.w} 0`}
                  style={`--dur:${s.dur}s; --delay:-${s.delay}s`}
                />
              ))
            }
          </g>
        </g>
      </g>
    </g>
  </svg>
</div>

<style>
  .tide svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* pale sand that sits quietly on the page in light and dark mode */
  .td-sand-stop {
    stop-color: color-mix(in srgb, var(--paper) 45%, #e4d2ae);
  }

  .td-wet {
    fill: color-mix(in srgb, var(--hero-deep) 22%, #d9c7a3);
    opacity: 0.35;
    animation: td-wet 18s ease-in-out infinite alternate;
  }

  /* flood and ebb: the water climbs the shore, pauses, and slowly draws back */
  .td-tide {
    animation: td-tide 18s ease-in-out infinite alternate;
  }

  @keyframes td-tide {
    from {
      transform: translate(0, 46px);
    }
    to {
      transform: translate(0, -58px);
    }
  }

  /* wet sand shows most when the water has drawn back */
  @keyframes td-wet {
    from {
      opacity: 0.32;
    }
    to {
      opacity: 0.06;
    }
  }

  .td-band {
    animation: td-drift var(--dur) linear infinite;
  }
  .td-band--white {
    fill: #fff;
    opacity: 0.5;
  }
  .td-band--deep {
    fill: var(--hero-deep);
    opacity: 0.22;
    animation-direction: reverse;
  }

  @keyframes td-drift {
    to {
      transform: translateX(-320px);
    }
  }

  .td-glints {
    animation: td-shimmer 7s ease-in-out infinite alternate;
  }
  .td-glint {
    fill: none;
    stroke: #fff;
    stroke-width: 2.2;
    stroke-linecap: round;
    opacity: 0.7;
  }

  @keyframes td-shimmer {
    from {
      opacity: 0.5;
      transform: translateX(-6px);
    }
    to {
      opacity: 1;
      transform: translateX(6px);
    }
  }

  .td-foam {
    fill: none;
    stroke: #fff;
    stroke-width: 3.2;
    stroke-linecap: round;
    opacity: 0.85;
  }
  .td-foam--out {
    stroke-width: 1.8;
    opacity: 0.45;
    animation: td-foam-out 6s ease-in-out infinite alternate;
  }

  @keyframes td-foam-out {
    from {
      transform: translateY(0);
      opacity: 0.25;
    }
    to {
      transform: translateY(-12px);
      opacity: 0.6;
    }
  }

  /* a small wave rolls toward the shore, spreads, and fades into the foam */
  .td-swash {
    fill: none;
    stroke: #fff;
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: td-swash var(--dur) ease-out infinite;
    animation-delay: var(--delay);
  }

  @keyframes td-swash {
    0% {
      opacity: 0;
      transform: translateY(26px) scaleX(0.7);
    }
    25% {
      opacity: 0.85;
    }
    70% {
      opacity: 0.4;
    }
    100% {
      opacity: 0;
      transform: translateY(-40px) scaleX(1.15);
    }
  }
</style>
