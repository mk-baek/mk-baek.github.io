---
/**
 * The topics my writing keeps returning to, collected from published Journal entries
 * at build time (see keywordStream in lib/content.ts). Bigger = more frequent (no numbers shown).
 * They drift slowly sideways like a current; each one opens the Journal filtered to it.
 * Motion stops on hover/focus, with "Pause motion", or with reduced motion (then they wrap).
 */
import type { Keyword } from '../lib/content';

interface Props {
  keywords: Keyword[];
}
const { keywords } = Astro.props;
const href = (k: Keyword) => k.href;
---

{
  keywords.length > 0 && (
    <nav class="stream" aria-label="Topics I keep returning to">
      <p class="stream__label">
        <span class="annot">flow through my writing</span>
      </p>
      <div class="stream__window">
        <ul class="stream__track">
          {keywords.map((k) => (
            <li>
              <a class={`kw kw--${k.weight}`} href={href(k)}>
                {k.label}
              </a>
            </li>
          ))}
        </ul>
        {/* a second copy makes the loop seamless; hidden from assistive tech and keyboard */}
        <ul class="stream__track stream__track--copy" aria-hidden="true">
          {keywords.map((k) => (
            <li>
              <a class={`kw kw--${k.weight}`} href={href(k)} tabindex="-1">
                {k.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )
}

<style>
  .stream {
    position: relative;
    z-index: 1;
  }

  .stream__label {
    margin: 0 0 6px;
  }

  .stream__label .annot {
    font-size: 16px;
  }

  .stream__window {
    display: flex;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .stream__track {
    display: flex;
    align-items: baseline;
    flex: none;
    gap: 0 40px;
    list-style: none;
    margin: 0;
    padding: 6px 20px 6px 0;
    animation: stream 60s linear infinite;
  }

  .stream__window:hover .stream__track,
  .stream__window:focus-within .stream__track {
    animation-play-state: paused;
  }

  @keyframes stream {
    to {
      transform: translateX(-100%);
    }
  }

  .kw {
    display: inline-flex;
    align-items: baseline;
    gap: 3px;
    min-height: 44px;
    align-items: center;
    font-family: var(--font-serif);
    color: var(--deep);
    text-decoration: none;
    white-space: nowrap;
    line-height: 1;
  }

  .kw:hover {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .kw--1 {
    font-size: 18px;
    font-weight: 300;
    opacity: 0.75;
  }
  .kw--2 {
    font-size: 22px;
    font-weight: 300;
  }
  .kw--3 {
    font-size: 28px;
    font-weight: 400;
  }
  .kw--4 {
    font-size: 36px;
    font-weight: 500;
    font-style: italic;
  }

  @media (prefers-reduced-motion: reduce) {
    .stream__window {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .stream__track {
      flex-wrap: wrap;
      flex: 1;
    }
    .stream__track--copy {
      display: none;
    }
  }
</style>
