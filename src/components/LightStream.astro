---
/**
 * A band of emerald water with a white line of light running through it, and a brighter
 * pulse that travels along the line. Drawn two periods wide and slid by one period,
 * so the motion loops seamlessly. Decorative only; paused with "Pause motion" and
 * static with reduced motion (global rules in global.css).
 */
interface Props {
  /** Height of the band in pixels. */
  height?: number;
  /** calm: soft white lines only — no glow, no travelling pulse. */
  calm?: boolean;
}
const { height = 200, calm = false } = Astro.props;
const uid = `ls${Math.random().toString(36).slice(2, 8)}`;

const W = 2400; // two periods of 1200 so the loop is seamless
const P = 1200;
const wave = (base: number, amp: number, phase: number, step = 40) => {
  const pts: string[] = [];
  for (let x = 0; x <= W; x += step) {
    const y = base + amp * Math.sin((x / P) * Math.PI * 2 + phase) + amp * 0.35 * Math.sin((x / P) * Math.PI * 4 + phase * 1.7);
    pts.push(`${x} ${y.toFixed(1)}`);
  }
  return pts;
};
const top = wave(62, 18, 0.2);
const bottom = wave(150, 14, 1.1);
const band = `M${top.join(' L')} L${bottom.slice().reverse().join(' L')} Z`;
const line = `M${wave(106, 24, 0.7, 20).join(' L')}`;
const sheen = [wave(84, 14, 0.4), wave(128, 12, 1.3)].map((p) => `M${p.join(' L')}`);
---

<div class:list={["light-stream", { "light-stream--calm": calm }]} style={`height:${height}px`} aria-hidden="true">
  <svg viewBox={`0 0 ${P} 210`} preserveAspectRatio="xMidYMid slice" focusable="false">
    <defs>
      <linearGradient id={`${uid}-water`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color: var(--sea-soft)"></stop>
        <stop offset="0.45" style="stop-color: var(--hero-sea); stop-opacity: 0.55"></stop>
        <stop offset="1" style="stop-color: var(--hero-deep); stop-opacity: 0.55"></stop>
      </linearGradient>
      <linearGradient id={`${uid}-fade`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#fff" stop-opacity="0"></stop>
        <stop offset="0.08" stop-color="#fff" stop-opacity="1"></stop>
        <stop offset="0.92" stop-color="#fff" stop-opacity="1"></stop>
        <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
      </linearGradient>
      <mask id={`${uid}-edges`}>
        <rect width={P} height="210" fill={`url(#${uid}-fade)`}></rect>
      </mask>
      <filter id={`${uid}-soft`} x="-5%" y="-40%" width="110%" height="180%">
        <feGaussianBlur stdDeviation="6"></feGaussianBlur>
      </filter>
      <filter id={`${uid}-glow`} x="-5%" y="-200%" width="110%" height="500%">
        <feGaussianBlur stdDeviation="5"></feGaussianBlur>
      </filter>
    </defs>

    <g mask={`url(#${uid}-edges)`}>
      <g class="ls-drift">
        <path d={band} fill={`url(#${uid}-water)`} filter={`url(#${uid}-soft)`}></path>
        {sheen.map((d) => <path class="ls-sheen" d={d} />)}
        {!calm && <path class="ls-glow" d={line} filter={`url(#${uid}-glow)`} />}
        <path class="ls-line" d={line}></path>
        {!calm && <path class="ls-pulse" d={line} />}
      </g>
    </g>
  </svg>
</div>

<style>
  .light-stream {
    width: 100%;
    overflow: hidden;
  }

  .light-stream svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .ls-sheen {
    fill: none;
    stroke: #fff;
    stroke-width: 1.2;
    opacity: 0.45;
  }

  .ls-glow {
    fill: none;
    stroke: #fff;
    stroke-width: 10;
    opacity: 0.55;
  }

  .ls-line {
    fill: none;
    stroke: #fff;
    stroke-width: 3.2;
    stroke-linecap: round;
  }

  /* a brighter pulse of light travelling along the line */
  .ls-pulse {
    fill: none;
    stroke: #fff;
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 90 2500;
    filter: drop-shadow(0 0 6px rgb(255 255 255 / 0.9));
    animation: ls-pulse 9s linear infinite;
  }

  .light-stream--calm .ls-line {
    stroke-width: 2;
    opacity: 0.9;
  }

  .light-stream--calm .ls-sheen {
    opacity: 0.6;
  }

  .ls-drift {
    animation: ls-drift 40s linear infinite;
  }

  @keyframes ls-drift {
    to {
      transform: translateX(-1200px);
    }
  }

  @keyframes ls-pulse {
    from {
      stroke-dashoffset: 1300;
    }
    to {
      stroke-dashoffset: -1300;
    }
  }
</style>
