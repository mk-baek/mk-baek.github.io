---
/**
 * Two small floating arrows: ↓ glides to the next stop on the page, ↑ returns to the top.
 * Rendered once by the Base layout on every page; each page names its stops (Journal entries:
 * section headings then sources; home: The Current Flow, The Current; lists: each item).
 *
 * A stop that is a <section> lands with its heading near the top; if the section marks the
 * end of its content with [data-glide-end] and that fits on screen, the content is centred.
 * With "Pause motion" or reduced motion the page jumps instead of gliding.
 */
interface Props {
  /** CSS selector for the stops, in page order */
  stops?: string;
  label?: string;
}
const { stops = '.read__body h2, .read__foot', label = 'Move through this entry' } = Astro.props;
---

<nav class="arrows" aria-label={label} data-arrows data-stops={stops}>
  <button type="button" class="arrows__btn" data-arrow="next" aria-label="Next section">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9.5l6 6 6-6"></path></svg>
  </button>
  <button type="button" class="arrows__btn" data-arrow="top" aria-label="Back to top">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 14.5l6-6 6 6"></path></svg>
  </button>
</nav>

<style>
  .arrows {
    position: fixed;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(20px, env(safe-area-inset-bottom));
    z-index: 30;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .arrows__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--sea-mid);
    border-radius: 50%;
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: blur(6px);
    color: var(--deep);
    cursor: pointer;
    transition:
      background var(--ease),
      color var(--ease),
      border-color var(--ease),
      opacity var(--ease);
  }

  .arrows__btn:hover,
  .arrows__btn:focus-visible {
    background: var(--deep);
    border-color: var(--deep);
    color: var(--paper);
  }

  .arrows__btn[disabled] {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
  }

  .arrows__btn svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media print {
    .arrows {
      display: none;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-arrows]');
  if (nav) {
    const next = nav.querySelector<HTMLButtonElement>('[data-arrow="next"]')!;
    const top = nav.querySelector<HTMLButtonElement>('[data-arrow="top"]')!;
    const stops = Array.from(document.querySelectorAll<HTMLElement>(nav.dataset.stops ?? ''));
    const GAP = 24; // space left above a heading when we land on it
    const still = () =>
      matchMedia('(prefers-reduced-motion: reduce)').matches || document.documentElement.classList.contains('motion-paused');

    // where the page should scroll to for a stop
    const targetY = (el: HTMLElement) => {
      const isSection = el.tagName === 'SECTION';
      const head = isSection ? ((el.firstElementChild as HTMLElement | null) ?? el) : el;
      const headTop = head.getBoundingClientRect().top + scrollY;
      const end = isSection ? el.querySelector<HTMLElement>('[data-glide-end]') : null;
      if (end) {
        const height = end.getBoundingClientRect().bottom + scrollY - headTop;
        if (height + GAP * 2 <= innerHeight) return headTop - (innerHeight - height) / 2;
      }
      return headTop - GAP;
    };
    const maxY = () => document.documentElement.scrollHeight - innerHeight;
    const nextY = () => stops.map(targetY).find((y) => y > scrollY + 8 && y < maxY() + 1);
    const go = (y: number) => scrollTo({ top: Math.max(0, y), behavior: still() ? 'instant' : 'smooth' });

    next.addEventListener('click', () => go(nextY() ?? maxY()));
    top.addEventListener('click', () => go(0));

    const update = () => {
      // a page that fits on one screen needs no arrows
      nav.hidden = maxY() < 40;
      top.disabled = scrollY < 8;
      next.disabled = scrollY >= maxY() - 8;
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    addEventListener('load', update);
    // the page grows as images and fonts arrive; re-check the ends when it does
    new ResizeObserver(update).observe(document.body);
    update();
  }
</script>
