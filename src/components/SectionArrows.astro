---
/**
 * Two small floating arrows for long Journal entries:
 * ↓ glides to the next section heading (then to the sources at the end), ↑ returns to the top.
 * They appear once the reader has scrolled past the opening of the entry.
 * With "Pause motion" or reduced motion the page jumps instead of gliding.
 */
---

<nav class="arrows" aria-label="Move through this entry" data-arrows hidden>
  <button type="button" class="arrows__btn" data-arrow="next" aria-label="Next section">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9.5l6 6 6-6" /></svg>
  </button>
  <button type="button" class="arrows__btn" data-arrow="top" aria-label="Back to top">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 14.5l6-6 6 6" /></svg>
  </button>
</nav>

<style>
  .arrows {
    position: fixed;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(20px, env(safe-area-inset-bottom));
    z-index: 30;
    display: flex;
    flex-direction: column;
    gap: 10px;
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
    transition:
      opacity var(--ease),
      transform var(--ease);
  }

  .arrows.is-shown {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .arrows__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--sea-mid);
    border-radius: 50%;
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: blur(6px);
    color: var(--deep);
    cursor: pointer;
    transition:
      background var(--ease),
      color var(--ease),
      border-color var(--ease),
      opacity var(--ease);
  }

  .arrows__btn:hover,
  .arrows__btn:focus-visible {
    background: var(--deep);
    border-color: var(--deep);
    color: var(--paper);
  }

  .arrows__btn[disabled] {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
  }

  .arrows__btn svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media print {
    .arrows {
      display: none;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-arrows]');
  if (nav) {
    const next = nav.querySelector<HTMLButtonElement>('[data-arrow="next"]')!;
    const top = nav.querySelector<HTMLButtonElement>('[data-arrow="top"]')!;
    // stops: each section heading in the entry, then the sources/footer at the end
    const stops = Array.from(document.querySelectorAll<HTMLElement>('.read__body h2, .read__foot'));
    const GAP = 24; // space left above a heading when we land on it
    const still = () =>
      matchMedia('(prefers-reduced-motion: reduce)').matches || document.documentElement.classList.contains('motion-paused');
    const go = (y: number) => scrollTo({ top: Math.max(0, y), behavior: still() ? 'instant' : 'smooth' });
    const nextStop = () => stops.find((el) => el.getBoundingClientRect().top > GAP + 8);

    next.addEventListener('click', () => {
      const el = nextStop();
      go(el ? el.getBoundingClientRect().top + scrollY - GAP : document.documentElement.scrollHeight);
    });
    top.addEventListener('click', () => go(0));

    const update = () => {
      nav.classList.toggle('is-shown', scrollY > innerHeight * 0.6);
      next.disabled = !nextStop();
    };
    nav.hidden = false;
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>
