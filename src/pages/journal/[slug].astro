---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StateBadge from '../../components/StateBadge.astro';
import ShareButton from '../../components/ShareButton.astro';
import SourceLine from '../../components/SourceLine.astro';
import ContinueList from '../../components/ContinueList.astro';
import Spread from '../../components/Spread.astro';
import { getSite, continuation, entrySpread, entryState, isFromTalks, showsDate, typeLabel, type Entry } from '../../lib/content';
import { formatDate, isoDay } from '../../lib/dates';
import { SITE } from '../../site';

export async function getStaticPaths() {
  const site = await getSite();
  return site.entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Entry };
const site = await getSite();
const d = entry.data;
const { Content, headings } = await render(entry);
const h2s = headings.filter((h) => h.depth === 2);
const showUpdated = d.updatedAt && d.publishedAt && isoDay(d.updatedAt) !== isoDay(d.publishedAt);
const next = continuation(site, { id: entry.id, questions: d.questions });
const isKo = d.lang === 'ko';
const spread = entrySpread(entry);
const contextLabel = isFromTalks(entry)
  ? 'From classes & talks'
  : d.context === 'practice'
    ? 'From practice'
    : d.context === 'reading'
      ? 'From readings'
      : undefined;
const titleInSpread = Boolean(spread && !spread.quote);
---

<Base title={d.title} description={d.summary} type="article" publishedAt={d.publishedAt}>
  {
    spread && (
      <Spread seed={entry.id} options={spread} title={d.title} lang={d.lang}>
        <p class="meta" slot="kicker">
          <span class="type">{typeLabel[d.type]}</span>
          {d.publishedAt && showsDate(entry) && <time datetime={isoDay(d.publishedAt)}>{formatDate(d.publishedAt)}</time>}
          {contextLabel && <span>{contextLabel}</span>}
        </p>
        {(d.quoteNote || d.quoteSource) && spread.quote && (
          <p class="spread__note">
            {d.quoteNote}
            {d.quoteNote && d.quoteSource && ' · '}
            {d.quoteSource && (
              <a href={d.quoteSource.url} rel="noopener">
                인용 출처: {d.quoteSource.title}
              </a>
            )}
          </p>
        )}
      </Spread>
    )
  }
  <article class="read container" lang={isKo ? 'ko' : undefined}>
    <header class:list={['read__head', { 'read__head--after-spread': spread }]}>
      <p class="meta" lang="en" hidden={titleInSpread}>
        <span class="type">{typeLabel[d.type]}</span>
        {d.publishedAt && showsDate(entry) && <time datetime={isoDay(d.publishedAt)}>{formatDate(d.publishedAt)}</time>}
        {showUpdated && showsDate(entry) && <span>Updated <time datetime={isoDay(d.updatedAt)}>{formatDate(d.updatedAt)}</time></span>}
        {contextLabel && <span>{contextLabel}</span>}
        {isKo && <span>KO</span>}
      </p>
      {!titleInSpread && <h1>{d.title}</h1>}
      <StateBadge state={entryState(entry)} />
      <p class="read__byline" lang="en">by {SITE.author}</p>
      {
        d.headQuote && (
          <figure class="read__headquote" lang="en">
            <blockquote>“{d.headQuote.text}”</blockquote>
            {d.headQuote.by && <figcaption>— {d.headQuote.by}</figcaption>}
          </figure>
        )
      }
      <span class="current-rule read__rule" aria-hidden="true"></span>
      {
        d.type === 'note' && d.sources[0] && (
          <p class="read__source" lang="en">
            <span class="eyebrow">On</span>
            <SourceLine source={d.sources[0]} />
          </p>
        )
      }
      {
        d.tagline && (
          <p class="read__tagline" lang="en">
            {d.tagline}
          </p>
        )
      }
    </header>

    {d.cover && <img class="read__cover" src={d.cover.src} alt={d.cover.alt} />}

    {
      h2s.length >= 3 && (
        <nav class="toc" aria-label="Contents" lang="en">
          <p class="eyebrow">Contents</p>
          <ol>
            {h2s.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="prose read__body">
      <Content />
    </div>

    <footer class="read__foot" lang="en">
      {
        d.sources.length > 0 && (
          <section aria-labelledby="sources-title" class="sources">
            <h2 class="sources__title" id="sources-title">
              Sources
            </h2>
            <ol>
              {d.sources.map((s) => (
                <li>
                  <SourceLine source={s} />
                </li>
              ))}
            </ol>
          </section>
        )
      }
      <ShareButton title={d.title} />
      <ContinueList continuation={next} />
      <a class="text-link back" href="/journal/">← Back to Journal</a>
    </footer>
  </article>
</Base>

<style>
  .read {
    max-width: calc(var(--measure) + var(--gutter) * 2);
  }

  .read__head {
    padding: 64px 0 8px;
    text-align: center;
  }

  .read__head .meta {
    justify-content: center;
  }

  .read__head h1 {
    font-size: var(--title-article);
    font-weight: 300;
    line-height: 1.12;
    letter-spacing: -0.02em;
    margin: 18px 0 14px;
    text-wrap: balance;
  }

  .read__byline {
    font-size: 15px;
    color: var(--ink-soft);
    margin: 10px 0 6px;
  }

  .read__headquote {
    max-width: 40em;
    margin: 18px auto 0;
  }

  .read__headquote blockquote {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(18px, 1.8vw, 21px);
    line-height: 1.55;
    color: var(--deep);
  }

  .read__headquote figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--ink-soft);
  }

  .read__head--after-spread {
    padding-top: 36px;
  }

  .read__rule {
    width: 160px;
    margin: 32px auto 8px;
  }

  .read__source {
    text-align: left;
    margin: 28px 0 0;
    padding: 18px 22px;
    background: var(--sea-soft);
    border-radius: 18px;
    font-size: 16px;
    line-height: 1.6;
  }

  /* same face as a bold pull quote in the body, centred in a soft box */
  .read__tagline {
    margin: 28px 0 0;
    padding: 22px 24px;
    background: var(--sea-soft);
    border-radius: 18px;
    text-align: center;
    font-family: var(--font-serif);
    font-size: calc(18px * 1.12);
    font-style: italic;
    font-weight: 600;
    line-height: 1.6;
    color: var(--deep);
  }

  @media (min-width: 768px) {
    .read__tagline {
      font-size: calc(19px * 1.12);
    }
  }

  .read__source .eyebrow {
    display: block;
    margin-bottom: 4px;
  }

  .read__cover {
    display: block;
    margin: 32px 0;
    border-radius: 12px;
  }

  .toc {
    margin: 40px 0;
    padding: 18px 22px;
    border-left: 3px solid var(--accent);
    font-size: 16px;
  }

  .toc ol {
    margin: 0;
    padding-left: 1.3em;
  }

  .read__body {
    margin-top: 48px;
  }

  .read__foot {
    margin-top: 72px;
  }

  .sources {
    margin-bottom: 32px;
  }

  .sources__title {
    font-size: 22px;
    font-weight: 300;
    margin-bottom: 10px;
  }

  .sources ol {
    padding-left: 1.3em;
    font-size: 16px;
    line-height: 1.6;
  }

  .sources li + li {
    margin-top: 8px;
  }

  .back {
    margin-top: 40px;
  }
</style>
