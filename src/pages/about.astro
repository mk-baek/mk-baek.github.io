---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
import LightStream from '../components/LightStream.astro';
import Tide from '../components/Tide.astro';

const { why } = SITE;

// **word** in the About copy is set in bold; everything else is plain text.
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const rich = (s: string) => escape(s).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
---

<Base title={why.title} description={SITE.description} arrows=".meanings">
  <div class="container about">
    <div class="about__intro">
      <header class="page-head about__head">
        <span class="annot">about</span>
        <h1>{why.title}</h1>
      </header>

      <div class="about__lead prose">
        {why.paragraphs.map((p, i) => (i === 0 ? <p class="about__first">{p}</p> : <p set:html={rich(p)} />))}
      </div>

      <div class="about__art about__art--flat">
        <LightStream height={200} />
      </div>
      <div class="about__art about__art--rising">
        <Tide />
      </div>
    </div>

    <section aria-labelledby="meanings-title" class="meanings">
      <h2 id="meanings-title" class="visually-hidden">{why.meaningsIntro}</h2>
      <ol>
        {
          why.meanings.map((m, i) => (
            <li>
              <span class="meanings__no" aria-hidden="true">
                0{i + 1}
              </span>
              <h3>{m.word}</h3>
              <p>{m.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

  </div>
</Base>

<style>
  /* the About page is sized to fit on one screen on a laptop: a smaller title, tighter lines */
  .about__head {
    padding-top: 28px;
    padding-bottom: 20px;
  }

  .about__head h1 {
    font-size: clamp(34px, 3.6vw, 46px);
    margin-bottom: 0;
  }

  .about__first {
    font-family: var(--font-serif);
    font-size: clamp(20px, 1.9vw, 25px);
    font-weight: 400;
    line-height: 1.3;
    color: var(--deep);
    margin-bottom: 0.7em;
  }

  .about__lead {
    font-size: 17px;
    line-height: 1.7;
  }

  .about__lead p {
    margin-bottom: 0.8em;
  }

  /* short laptop screens (around 720px tall): a little less air so it still fits */
  @media (min-width: 1000px) and (max-height: 760px) {
    .about__head {
      padding-top: 10px;
      padding-bottom: 14px;
    }

    .about__lead {
      line-height: 1.62;
    }
  }

  .about__intro {
    position: relative;
  }

  .about__head,
  .about__lead {
    position: relative;
    z-index: 1;
  }

  .about__art--flat {
    margin: 48px calc(var(--gutter) * -1);
  }

  .about__art--rising {
    display: none;
  }

  /* wide screens: the stream winds up through the empty space on the right */
  @media (min-width: 1000px) {
    .about__intro {
      padding-bottom: 28px;
    }

    .about__art--flat {
      display: none;
    }

    .about__art--rising {
      display: block;
      position: absolute;
      z-index: 0;
      right: -3%;
      top: -4%;
      bottom: 10%;
      width: 48%;
      pointer-events: none;
    }
  }

  /* the three meanings always sit above the illustration */
  .meanings {
    position: relative;
    z-index: 1;
  }

  .meanings ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 36px;
  }

  @media (min-width: 800px) {
    .meanings ol {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 40px;
    }
  }

  .meanings li {
    border-top: 1px solid var(--sea-mid);
    padding-top: 14px;
  }

  .meanings__no {
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
  }

  /* same face as the page title (Why The Current), a little lighter */
  .meanings h3 {
    font-size: clamp(28px, 2.8vw, 36px);
    font-weight: 360;
    letter-spacing: -0.02em;
    font-style: normal;
    margin: 2px 0 6px;
  }

  .meanings p {
    color: var(--ink-soft);
    max-width: 24em;
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
  }

</style>
