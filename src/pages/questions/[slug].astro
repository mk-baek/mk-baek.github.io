---
import Base from '../../layouts/Base.astro';
import EntryItem from '../../components/EntryItem.astro';
import StateBadge from '../../components/StateBadge.astro';
import Spread from '../../components/Spread.astro';
import {
  getSite,
  explorableQuestions,
  entriesForQuestion,
  questionState,
  resolveSpread,
  type Entry,
  type Question,
} from '../../lib/content';

export async function getStaticPaths() {
  const site = await getSite();
  return explorableQuestions(site).map((question) => ({ params: { slug: question.id }, props: { question } }));
}

const { question } = Astro.props as { question: Question };
const site = await getSite();
const d = question.data;
const entries = entriesForQuestion(site, question.id);
const recommended = d.recommended
  .map((id) => entries.find((e) => e.id === id))
  .filter((e): e is Entry => Boolean(e));
const isKo = d.lang === 'ko';
const spread = resolveSpread(d.spread, true);
const spreadOptions = spread ? { ...spread, scene: spread.scene ?? ('ripple' as const) } : null;
---

<Base title={d.title} description={d.introduction}>
  {
    spreadOptions && (
      <Spread seed={question.id} options={spreadOptions} title={d.title} lang={d.lang}>
        <p class="q-label" slot="kicker">
          <span class="annot">a question I keep returning to</span> <StateBadge state={questionState(question)} />
        </p>
      </Spread>
    )
  }
  <div class="container">
    <header class="q-head">
      {!spreadOptions && (
        <>
          <p class="q-label">
            <span class="annot">a question I keep returning to</span> <StateBadge state={questionState(question)} />
          </p>
          <h1 lang={isKo ? 'ko' : undefined}>{d.title}</h1>
        </>
      )}
      {spreadOptions?.quote && <h1 lang={isKo ? 'ko' : undefined}>{d.title}</h1>}
      <p class="q-intro" lang={isKo ? 'ko' : undefined}>{d.introduction}</p>
      {
        d.currentThinking && (
          <div class="q-thinking" lang={isKo ? 'ko' : undefined}>
            <p class="eyebrow" lang="en">
              Current thinking
            </p>
            <p>{d.currentThinking}</p>
          </div>
        )
      }
    </header>

    {
      recommended.length > 0 && (
        <section class="section measure" aria-labelledby="start-title">
          <h2 class="section-title" id="start-title">
            Start here
          </h2>
          <ul class="entry-list">
            {recommended.map((e) => (
              <EntryItem entry={e} />
            ))}
          </ul>
        </section>
      )
    }

    {
      entries.length > 0 && (
        <section class="section measure" aria-labelledby="entries-title" data-sortable>
          <div class="list-head">
            <h2 class="section-title" id="entries-title">
              Entries on this question
            </h2>
            {entries.length > 1 && (
              <button type="button" class="btn sort" data-sort hidden>
                Oldest first
              </button>
            )}
          </div>
          <ul class="entry-list" data-sort-list>
            {entries.map((e) => (
              <EntryItem entry={e} />
            ))}
          </ul>
        </section>
      )
    }

    <a class="text-link back" href="/journal/">← Back to Journal</a>
  </div>
</Base>

<style>
  .q-head {
    max-width: 820px;
    padding: 48px 0 0;
  }
  .q-head h1 {
    font-size: var(--title-article);
    font-weight: 300;
    line-height: 1.15;
    margin: 0 0 20px;
    text-wrap: balance;
  }
  .q-label {
    margin: 0 0 12px;
  }
  .q-intro {
    color: var(--ink-soft);
    max-width: var(--measure);
  }
  .q-thinking {
    max-width: var(--measure);
    margin-top: 24px;
    padding: 16px 20px;
    background: var(--sea-soft);
    border-radius: 18px;
  }
  .q-thinking p:last-child {
    margin: 0;
  }
  .list-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 8px 16px;
    border-bottom: 1px solid var(--sea-mid);
    margin-bottom: 8px;
  }
  .list-head .section-title {
    border: 0;
    margin: 0;
  }
  .sort {
    margin-bottom: 8px;
  }
  .back {
    margin-top: 48px;
  }
</style>

<script>
  for (const section of document.querySelectorAll<HTMLElement>('[data-sortable]')) {
    const btn = section.querySelector<HTMLButtonElement>('[data-sort]');
    const list = section.querySelector<HTMLUListElement>('[data-sort-list]');
    if (!btn || !list) continue;
    let newestFirst = true;
    btn.hidden = false;
    btn.addEventListener('click', () => {
      newestFirst = !newestFirst;
      list.append(...Array.from(list.children).reverse());
      btn.textContent = newestFirst ? 'Oldest first' : 'Newest first';
    });
  }
</script>
